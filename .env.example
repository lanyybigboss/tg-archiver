# ── 必填 ────────────────────────────────────────────────
# 从 @BotFather 获取
BOT_TOKEN=
# 只允许这个 Telegram 用户 ID 操作；留 0 表示不限制
OWNER_ID=0

# 面板访问令牌（必填）。生成：openssl rand -hex 16
# 面板可以修改队列、触发缓存清理、读取事件，因此不允许无认证暴露。
PANEL_TOKEN=

# ── 路径 ────────────────────────────────────────────────
# 数据根目录：下载、数据库、日志、worker 存储槽都在这里
BASE_DIR=/opt/tg-archiver/data

# ── 下载 ────────────────────────────────────────────────
# 并发任务数 1–8。注意总带宽通常受上游账号限制，加到 2 以上只是把同样的带宽分给多个文件
MAX_WORKERS=2
# 单文件分片数（tdl -t）
TDL_THREADS=16
# 单任务超时（秒）
TDL_TIMEOUT=900
# 失败重试上限
MAX_RETRY=10
# 缓存上限（GB），超出后按完成时间删最旧的
CACHE_LIMIT_GB=80

# ── 代理 ────────────────────────────────────────────────
# tdl 走 SOCKS5（MTProto）
TDL_PROXY=socks5://127.0.0.1:7891
# Bot API 与节点测速走 HTTP 代理
HTTP_PROXY=http://127.0.0.1:7890

# ── 面板 ────────────────────────────────────────────────
PANEL_ADDR=0.0.0.0:6186
# 告警消息里附带的链接
PANEL_URL=http://127.0.0.1:6186/

# ── 节点自动测速（可选）────────────────────────────────
# 定期实测各节点带宽并切到最快的。需要 mihomo/clash 的控制器 API。
NODE_TEST_ENABLED=false
NODE_TEST_INTERVAL_HOURS=3
MIHOMO_API=http://127.0.0.1:9090
NODE_GROUP=节点选择

# ── 告警推送（可选）────────────────────────────────────
# 留空则只写 events 表，由 agent 通过 /api/events 拉取
ALERT_WEBHOOK=
# generic = 通用 JSON；feishu = 飞书自定义机器人
ALERT_WEBHOOK_FORMAT=generic
